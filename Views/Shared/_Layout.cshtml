@using BookStoreWeb.Models
@{
    string? username = Context.Session.GetString("Username");
    string? fullName = Context.Session.GetString("FullName");
    string? role = Context.Session.GetString("Role");

    // Tính tổng tiền mua hàng của user hiện tại để xác định Hạng Thành Viên
    decimal userTotalSpent = 0;
    if (username != null && role != "Admin")
    {
        // Giả lập tính dựa trên lịch sử hoặc mặc định tích lũy
        userTotalSpent = 1250000; // Khách mẫu ở mức Hạng Vàng (Gold) để demo sinh động
    }
    var tierInfo = PromoManager.GetMembershipTier(userTotalSpent);
    var notifications = PromoManager.LoadNotifications();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookStoreWeb</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <!-- Topbar Tổng đài & Thông tin thành viên -->
        <div class="bg-primary text-white py-1 small">
            <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
                <span>🎧 Tổng đài CSKH: <strong>1900 6868</strong> | ✉️ Email: hotro@bookstore.vn</span>
                <div>
                    @if (username != null && role != "Admin")
                    {
                        <span class="badge @tierInfo.BadgeColor me-2">👑 Hạng thẻ: @tierInfo.TierName (Ưu đãi đặc quyền -@tierInfo.ExtraDiscount%)</span>
                    }
                    <span class="d-none d-md-inline">🚚 Miễn phí giao hàng đơn từ 250k</span>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-warning" asp-controller="Home" asp-action="Index">📚 BookStoreWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Home" asp-action="Index">🏠 Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Cart" asp-action="Index">🛒 Giỏ hàng</a></li>
                        <li class="nav-item"><a class="nav-link text-light" asp-controller="Cart" asp-action="MyOrders">📦 Đơn hàng của tôi</a></li>
                        @if (role == "Admin")
                        {
                            <li class="nav-item"><a class="nav-link text-warning fw-bold" asp-controller="Admin" asp-action="Index">⚙️ Quản trị Admin</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        <!-- CHUÔNG THÔNG BÁO KHUYẾN MÃI (NOTIFICATION BELL) -->
                        <li class="nav-item dropdown me-3">
                            <a class="nav-link text-warning position-relative" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown" title="Thông báo khuyến mãi">
                                🔔 <span class="position-absolute top-2 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">@notifications.Count</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" style="width: 320px; max-height: 400px; overflow-y: auto;">
                                <li class="dropdown-header fw-bold text-primary">📢 Hộp Thư Thông Báo Khuyến Mãi</li>
                                <li><hr class="dropdown-divider"></li>
                                @if (notifications.Any())
                                {
                                    foreach (var n in notifications)
                                    {
                                        <li>
                                            <div class="dropdown-item-text py-2 border-bottom">
                                                <div class="fw-bold text-danger small">🔥 @n.Title</div>
                                                <div class="small text-muted">@n.Content</div>
                                                <div class="text-end text-muted" style="font-size: 0.7rem;">@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                            </div>
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li><span class="dropdown-item-text small text-muted">Chưa có thông báo nào.</span></li>
                                }
                            </ul>
                        </li>

                        @if (username != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-info fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    👤 Chào, @fullName (@role)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Cart" asp-action="MyOrders">📦 Lịch sử đơn hàng</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger fw-bold" asp-controller="Auth" asp-action="Logout">🚪 Đăng xuất</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-light" asp-controller="Auth" asp-action="Login">🔑 Đăng nhập</a></li>
                            <li class="nav-item"><a class="nav-link text-light" asp-controller="Auth" asp-action="Register">📝 Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <strong>✨ Thông báo:</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Nút Hotline nổi góc phải -->
    <div style="position: fixed; bottom: 20px; right: 20px; z-index: 1050;">
        <a href="tel:19006868" class="btn btn-danger rounded-pill shadow-lg px-3 py-2 fw-bold d-flex align-items-center gap-2 border border-2 border-white">
            <span>📞 Hotline: 1900 6868</span>
        </a>
    </div>

    <footer class="bg-dark text-light pt-4 pb-3 mt-5 border-top">
        <div class="container-fluid px-4">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="text-warning fw-bold">📚 HỆ THỐNG NHÀ SÁCH BOOKSTOREWEB</h5>
                    <p class="small text-secondary mb-2">Nền tảng cung cấp sách Công nghệ, Kinh tế và Văn học chính hãng.</p>
                    <p class="small mb-1">📍 <strong>Địa chỉ:</strong> Số 3 Cầu Giấy, Đống Đa, Hà Nội</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-info fw-bold text-uppercase">🎧 Tổng Đài Hỗ Trợ Khách Hàng</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-1">📞 <strong>Hotline:</strong> <span class="text-warning fw-bold">1900 6868</span></li>
                        <li class="mb-1">✉️ <strong>Email:</strong> cskh@bookstoreweb.vn</li>
                        <li>⏰ <strong>Phục vụ:</strong> 08:00 - 22:00 hàng ngày</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-info fw-bold text-uppercase">🛡️ Đặc Quyền Thành Viên VIP</h6>
                    <ul class="list-unstyled small text-secondary">
                        <li class="mb-1">✔️ Tích lũy điểm thưởng thăng hạng thẻ</li>
                        <li class="mb-1">✔️ Giảm giá đặc quyền theo hạng thành viên</li>
                        <li>✔️ Nhận thông báo ưu đãi độc quyền qua chuông 🔔</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-3" />
            <div class="text-center small text-secondary">
                &copy; 2026 - <strong>BookStoreWeb</strong> - Hệ thống Quản lý và Bán sách trực tuyến <br />
                Phát triển bởi: <strong>Nhóm 2 môn Lập trình WEB</strong>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>