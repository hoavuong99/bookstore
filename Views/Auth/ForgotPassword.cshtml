@{
    ViewData["Title"] = "Quên Mật Khẩu";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5" style="max-width: 480px; width: 100%;">
        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 64px; height: 64px;">
                <i class="bi bi-key-fill fs-2"></i>
            </div>
            <h3 class="fw-bold text-dark">Khôi Phục Mật Khẩu</h3>
            <p class="text-muted small">Nhập email đã đăng ký để hệ thống gửi hướng dẫn đặt lại mật khẩu cho bạn.</p>
        </div>

        <!-- Hiển thị thông báo lỗi nếu không tìm thấy email -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Hiển thị thông báo thành công khi email hợp lệ -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">Địa chỉ Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="email" class="form-control" required placeholder="nhập email của bạn..." />
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm rounded-pill mb-3">
                <i class="bi bi-send-fill me-1"></i> Gửi Yêu Cầu Khôi Phục
            </button>
        </form>

        <div class="text-center">
            <a href="@Url.Action("Login", "Auth")" class="text-decoration-none small text-muted fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang Đăng nhập
            </a>
        </div>
    </div>
</div>