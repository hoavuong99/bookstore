@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm p-4">
            <h3 class="text-center text-primary mb-4">🔑 Đăng Nhập Hệ Thống</h3>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label class="form-label">Tên đăng nhập</label>
                    <input type="text" name="username" class="form-control" required placeholder="Nhập username...">
                </div>
                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password" name="password" class="form-control" required placeholder="Nhập mật khẩu...">
                </div>
                <div class="mb-3 text-end">
                    <a href="@Url.Action("ForgotPassword", "Auth")" class="text-decoration-none small text-primary fw-bold">Quên mật khẩu?</a>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Đăng Nhập</button>
            </form>
            <div class="text-center mt-3">
                <p>Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
            </div>
        </div>
    </div>
</div>