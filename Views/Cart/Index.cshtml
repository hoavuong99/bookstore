@model IEnumerable<BookStoreWeb.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng và Thanh toán";
}

<div class="container my-4">
    <h2 class="mb-4 text-primary fw-bold">🛒 Giỏ Hàng & Thanh Toán Trực Tuyến</h2>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            <!-- Cột danh sách sản phẩm -->
            <div class="col-md-7">
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0">Danh sách sách đã chọn</h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Giá</th>
                                    <th style="width: 80px;">SL</th>
                                    <th>Thành tiền</th>
                                    <th>Xóa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(item.CoverImage))
                                                {
                                                    <img src="@item.CoverImage" class="rounded border" style="width: 40px; height: 55px; object-fit: cover;" />
                                                }
                                                <div>
                                                    <div class="fw-bold small">@item.Title</div>
                                                    @if (item.DiscountPercent > 0)
                                                    {
                                                        <span class="badge bg-danger" style="font-size: 0.65rem;">-@item.DiscountPercent%</span>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-danger fw-bold small">@item.Price.ToString("N0") đ</td>
                                        <td><span class="badge bg-secondary">@item.Quantity</span></td>
                                        <td class="fw-bold small text-primary">@item.TotalPrice.ToString("N0") đ</td>
                                        <td>
                                            <a href="@Url.Action("Remove", "Cart", new { id = item.BookId })" class="btn btn-sm btn-outline-danger py-0 px-2">🗑️</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Cột Thông tin nhận hàng & Thanh toán -->
            <div class="col-md-5">
                <div class="card shadow-sm border-primary p-3">
                    <h4 class="mb-3 text-primary fw-bold">📦 Thông Tin & Thanh Toán</h4>
                    <form asp-action="Checkout" method="post">
                        <div class="mb-2">
                            <label class="form-label fw-bold small">Người nhận</label>
                            <input type="text" name="receiverName" value="@Context.Session.GetString("FullName")" class="form-control form-control-sm" required placeholder="Họ và tên..." />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold small">Số điện thoại</label>
                            <input type="text" name="receiverPhone" class="form-control form-control-sm" required placeholder="SĐT liên hệ..." />
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold small">Địa chỉ giao hàng</label>
                            <textarea name="shippingAddress" class="form-control form-control-sm" rows="2" required placeholder="Số nhà, tên đường, quận/huyện..."></textarea>
                        </div>

                        <!-- Phương thức thanh toán -->
                        <div class="mb-3 p-2 bg-light rounded border">
                            <label class="form-label fw-bold text-danger small mb-2">💳 Chọn Phương Thức Thanh Toán:</label>
                            
                            <div class="form-check mb-1">
                                <input class="form-check-input payment-radio" type="radio" name="paymentMethod" id="codMethod" value="Thanh toán khi nhận hàng (Ship COD)" checked data-target="cod-box">
                                <label class="form-check-label small fw-bold" for="codMethod">🚚 Thanh toán khi nhận hàng (Ship COD)</label>
                            </div>

                            <div class="form-check mb-1">
                                <input class="form-check-input payment-radio" type="radio" name="paymentMethod" id="bankMethod" value="Chuyển khoản Ngân hàng (QR Code)" data-target="bank-box">
                                <label class="form-check-label small fw-bold" for="bankMethod">🏦 Chuyển khoản Ngân hàng (Vietcombank / MB)</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input payment-radio" type="radio" name="paymentMethod" id="walletMethod" value="Ví điện tử (Momo / VNPay)" data-target="wallet-box">
                                <label class="form-check-label small fw-bold" for="walletMethod">📱 Ví điện tử (Momo / VNPay)</label>
                            </div>

                            <!-- KHUNG HIỂN THỊ MÃ QR KHI CHỌN CHUYỂN KHOẢN HOẶC VÍ -->
                            <div id="qr-container" class="mt-3 p-3 bg-white rounded border text-center d-none">
                                <div id="bank-box" class="qr-content d-none">
                                    <div class="small fw-bold text-primary mb-1">Quét mã QR Ngân hàng (Vietcombank)</div>
                                    <img src="https://api.vietqr.io/image/970436-1039888888-vn.jpg?amount=@ViewBag.Total&addInfo=ThanhToanBookStore&accountName=LE%20TIEN%20DUNG" class="img-fluid rounded border mb-2" style="max-width: 150px;" alt="QR Code Bank" />
                                    <div class="text-muted" style="font-size: 0.75rem;">STK: <strong>1039888888</strong> | Chủ tài khoản: <strong>LE TIEN DUNG</strong></div>
                                    <div class="text-danger fw-bold" style="font-size: 0.75rem;">Số tiền: @ViewBag.Total.ToString("N0") đ</div>
                                </div>

                                <div id="wallet-box" class="qr-content d-none">
                                    <div class="small fw-bold text-success mb-1">Quét mã QR Ví Momo / VNPay</div>
                                    <img src="https://api.vietqr.io/image/970422-0988888888-momo.jpg?amount=@ViewBag.Total&addInfo=ThanhToanMomo" class="img-fluid rounded border mb-2" style="max-width: 150px;" alt="QR Code Momo" />
                                    <div class="text-muted" style="font-size: 0.75rem;">SĐT Ví: <strong>0988.888.888</strong> | ND: ThanhToanBookStore</div>
                                    <div class="text-danger fw-bold" style="font-size: 0.75rem;">Số tiền: @ViewBag.Total.ToString("N0") đ</div>
                                </div>
                                <div class="small text-success mt-2 fw-bold">✨ Hệ thống tự động xác nhận giao dịch sau khi quét mã!</div>
                            </div>
                        </div>

                        <hr class="my-2" />
                        <div class="d-flex justify-content-between mb-3 fs-5 fw-bold">
                            <span>Tổng thanh toán:</span>
                            <span class="text-danger">@ViewBag.Total.ToString("N0") đ</span>
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold shadow">🚀 Xác Nhận Đặt Hàng & Thanh Toán</button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <h4>Giỏ hàng của bạn đang trống!</h4>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3 fw-bold">Quay lại mua sắm</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.payment-radio').change(function () {
                var target = $(this).data('target');
                if (target === 'cod-box') {
                    $('#qr-container').addClass('d-none');
                } else {
                    $('#qr-container').removeClass('d-none');
                    $('.qr-content').addClass('d-none');
                    $('#' + target).removeClass('d-none');
                }
            });
        });
    </script>
}